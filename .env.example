# PostgreSQL connection string used only by server-side code and Drizzle Kit.
# Replace the values below in your local .env file. Never expose this variable
# with a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/churrascaria_ponto

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 private bucket. Create an R2 API token with object read/write
# limited to this bucket. These variables are server-only.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=churrascaria-ponto-private

# Runtime and observability. Use APP_ENV=staging in homologation and
# APP_ENV=production only in the public production service.
APP_ENV=development
LOG_LEVEL=info

# High-entropy server-only pepper used to hash REP device credentials. Generate
# independently per environment with: openssl rand -hex 32
REP_CREDENTIAL_PEPPER=replace-with-64-random-hex-characters

# Local biometric provider. Generate independent secrets with:
# openssl rand -base64 32  (encryption key)
# openssl rand -hex 32     (internal provider token)
BIOMETRIC_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
BIOMETRIC_PROVIDER_TOKEN=replace-with-64-random-hex-characters
BIOMETRIC_PROVIDER_URL=http://localhost:8100
BIOMETRIC_MIN_SIMILARITY=0.80
BIOMETRIC_MIN_SCORE_GAP=0.08
